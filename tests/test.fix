module Test;

import ErrnoTest::main;
import FileSystemTest::main;
import Minilib.Testing.UnitTest::{TestSuite, TestSuite::run};
import PathTest::main;
import PlatformTest::main;
import SignalTest::main;
import Std::IO;

testsuite: TestSuite;
testsuite = [
    ("ErrnoTest", ErrnoTest::main),
    ("FileSystemTest", FileSystemTest::main),
    ("PathTest", PathTest::main),
    ("PlatformTest", PlatformTest::main),
    ("SignalTest", SignalTest::main),
];


test: IO ();
test = (
    testsuite.run
);

